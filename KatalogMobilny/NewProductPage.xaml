<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.NewProductPage"
             Title="Nowy produkt">
    <ScrollView x:Name="FormularzScrollView">
        <VerticalStackLayout x:Name="FormularzLayout" Padding="20" Spacing="12">
            <Label x:Name="TytulLabel"
                   Text="Nowy produkt"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label x:Name="NazwaLabel" Text="Nazwa produktu" FontAttributes="Bold" />
            <Entry x:Name="NazwaEntry"
                   Placeholder="Wpisz nazwę produktu"
                   ClearButtonVisibility="WhileEditing"
                   MinimumHeightRequest="52" />

            <Label x:Name="CenaLabel" Text="Cena (zł)" FontAttributes="Bold" />
            <Entry x:Name="CenaEntry"
                   Placeholder="np. 899,99"
                   Keyboard="Numeric"
                   ClearButtonVisibility="WhileEditing"
                   MinimumHeightRequest="52" />

            <Label x:Name="IloscLabel" Text="Ilość" FontAttributes="Bold" />
            <Entry x:Name="IloscEntry"
                   Placeholder="np. 2"
                   Keyboard="Numeric"
                   ClearButtonVisibility="WhileEditing"
                   MinimumHeightRequest="52" />

            <Label x:Name="KategoriaLabel" Text="Kategoria" FontAttributes="Bold" />
            <Picker x:Name="KategoriaPicker"
                    Title="Wybierz kategorię"
                    MinimumHeightRequest="52">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Procesory</x:String>
                        <x:String>Płyty główne</x:String>
                        <x:String>Karty graficzne</x:String>
                        <x:String>Dyski SSD</x:String>
                        <x:String>Pamięci RAM</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <HorizontalStackLayout x:Name="DostepnoscLayout" Spacing="12" VerticalOptions="Center">
                <Switch x:Name="DostepnoscSwitch"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="52"
                        Toggled="DostepnoscSwitch_Toggled" />
                <Label x:Name="DostepnoscLabel"
                       Text="Produkt niedostępny"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid x:Name="AkcjeGrid" Margin="0,8,0,0">
                <Button
                        x:Name="DodajProduktButton"
                        Text="Dodaj produkt"
                        MinimumHeightRequest="52"
                        Clicked="NowyProdukt_Clicked" />
            </Grid>

            <Border x:Name="WynikBorder" Padding="12" MinimumHeightRequest="70">
                <Label x:Name="EtykietaWyniku"
                       Text="Wypełnij formularz i wybierz „Dodaj produkt”."
                       LineBreakMode="WordWrap" />
            </Border>

            <Button x:Name="ResetujFormularzButton"
                    Text="Resetuj formularz"
                    MinimumHeightRequest="52"
                    Clicked="Reset_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>